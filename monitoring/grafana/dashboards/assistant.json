{
  "uid": "assistant",
  "title": "Juani \u00b7 assistant service",
  "tags": [
    "botjonh"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "constant",
        "query": "jd-botjonh",
        "hide": 2
      },
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "assistant,assistant-staging",
        "current": {
          "text": "assistant",
          "value": "assistant"
        },
        "options": [
          {
            "text": "assistant",
            "value": "assistant",
            "selected": true
          },
          {
            "text": "assistant-staging",
            "value": "assistant-staging",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-monitoring"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-monitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_count",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": [
              "metric.label.response_code_class"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "cloud-monitoring-auto",
            "view": "FULL"
          },
          "aliasBy": "{{metric.label.response_code_class}}"
        }
      ]
    },
